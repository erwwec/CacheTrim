<Window x:Class="DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Desktop Pet" Width="260" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False">
    <Grid ClipToBounds="False">
        <Canvas x:Name="PetCanvas" Width="260" Height="320" RenderOptions.BitmapScalingMode="NearestNeighbor">
            <!-- White thought cloud -->
            <Ellipse x:Name="ThoughtDotLarge" Canvas.Left="117" Canvas.Top="146" Width="17" Height="17"
                     Fill="White" Stroke="#FF171717" StrokeThickness="2.5" IsHitTestVisible="False" Visibility="Collapsed" />
            <Ellipse x:Name="ThoughtDotSmall" Canvas.Left="124" Canvas.Top="162" Width="10" Height="10"
                     Fill="White" Stroke="#FF171717" StrokeThickness="2.5" IsHitTestVisible="False" Visibility="Collapsed" />
            <Grid x:Name="SpeechBubble" Canvas.Left="8" Canvas.Top="0" Width="244" Height="174" Visibility="Collapsed">
                <Path Stretch="Fill" Fill="White" Stroke="#FF111111" StrokeThickness="3"
                      Data="M 33,139 C 15,139 4,125 9,109 C -1,91 8,69 27,64 C 23,43 38,28 57,34 C 65,13 90,8 105,27 C 119,8 145,12 154,31 C 174,17 196,28 198,48 C 221,48 234,68 223,87 C 240,104 227,125 208,126 C 200,146 177,153 158,140 C 143,161 117,161 103,143 C 85,158 61,154 52,140 C 45,144 37,143 33,139 Z" />
                <TextBlock x:Name="SpeechText" Margin="37,35,37,51" Foreground="#FF111111"
                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>

            <!-- Detailed transparent sprite images made from the video reference -->
            <Image x:Name="PetSprite" Canvas.Left="74" Canvas.Top="180" Width="120" Height="112"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   MouseLeftButtonDown="Pet_MouseLeftButtonDown" MouseMove="Pet_MouseMove"
                   MouseLeftButtonUp="Pet_MouseLeftButtonUp" MouseRightButtonUp="Pet_MouseRightButtonUp" />
            <TextBlock x:Name="PropGlyph" Canvas.Left="155" Canvas.Top="243" FontSize="17" Visibility="Collapsed" />
        </Canvas>
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=PetSprite}" Placement="Top"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <ScrollViewer x:Name="MenuScroll" Width="253" MaxHeight="580" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <Border x:Name="Menu" Width="235" Padding="9" CornerRadius="9"
                      Background="#F3281838" BorderBrush="#FFD56BFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Клод" Foreground="White" FontWeight="Bold" Margin="2,0,2,5" />
                    <Button Content="Закрыть меню" Click="CloseMenu_Click" Margin="0,2" Padding="6,3" />
                    <TextBlock x:Name="SizeLabel" Text="Размер: 100%" Foreground="White" Margin="2,5,2,0" />
                    <Slider x:Name="SizeSlider" Minimum="0.5" Maximum="2" Value="0.6" Width="205"
                            ValueChanged="SizeSlider_ValueChanged" Margin="0,0,0,4" />
                    <TextBlock x:Name="ChatterLabel" Foreground="White" Margin="2,4,2,0" />
                    <Slider x:Name="ChatterSlider" Minimum="0" Maximum="2" Value="1" Width="205"
                            ValueChanged="ChatterSlider_ValueChanged" Margin="0,0,0,3" />
                    <TextBlock x:Name="JumpLabel" Foreground="White" Margin="2,3,2,0" />
                    <Slider x:Name="JumpSlider" Minimum="0.5" Maximum="2" Value="1" Width="205"
                            ValueChanged="JumpSlider_ValueChanged" Margin="0,0,0,3" />
                    <Button x:Name="QuietButton" Content="Не отвлекать: выкл" Click="Quiet_Click" Margin="0,2" Padding="6,3" />
                    <Button x:Name="BringSecretButton" Content="Принеси секрет" Click="BringSecret_Click" Margin="0,2" Padding="6,3" />
                    <Button x:Name="SurpriseButton" Content="Секреты: вкл" Click="Surprise_Click" Margin="0,2" Padding="6,3" />
                    <Button x:Name="SeatButton" Content="Место: свободно" Click="Seat_Click" Margin="0,2" Padding="6,3" />
                    <Button x:Name="CollectionButton" Content="Коллекция: вкл" Click="Collection_Click" Margin="0,2" Padding="6,3" />
                    <Button x:Name="RoutineButton" Content="Распорядок: вкл" Click="Routine_Click" Margin="0,2" Padding="6,3" />
                    <TextBlock Text="Свои фразы (по одной на строку)" Foreground="White" Margin="2,5,2,2" />
                    <TextBox x:Name="PhraseTextBox" Height="72" MaxLength="500" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" />
                    <Button Content="Сохранить фразы" Click="SavePhrases_Click" Margin="0,3" Padding="6,3" />
                    <Button Content="Прыгнуть" Click="Jump_Click" Margin="0,2" Padding="6,3" />
                    <Button x:Name="AudioButton" Content="Реакция на звук: вкл" Click="Audio_Click" Margin="0,2" Padding="6,3" />
                    <Button x:Name="LyricsButton" Content="Текст песни: выкл" Click="Lyrics_Click" Margin="0,2" Padding="6,3" />
                    <Button x:Name="LyricsStatusButton" Content="Почему нет текста песни?" Click="LyricsStatus_Click" Margin="0,2" Padding="6,3" />
                    <Button Content="Выход" Click="Exit_Click" Margin="0,2" Padding="6,3" />
                </StackPanel>
              </Border>
            </ScrollViewer>
        </Popup>
    </Grid>
</Window>
