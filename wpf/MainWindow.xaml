<Window x:Class="CacheTrim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CacheTrim" Width="1320" Height="860" MinWidth="1010" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="#FF0F1113" ShowInTaskbar="True"
        Loaded="OnWindowLoaded" StateChanged="OnWindowStateChanged" Closed="OnWindowClosed">
    <Window.Resources>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="19" Height="19" CornerRadius="5" BorderThickness="1"
                                    BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" Background="Transparent">
                                <TextBlock x:Name="Mark" Text="✓" FontSize="13" FontWeight="Bold" Foreground="#101820"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowSurface" Margin="0" CornerRadius="0" BorderThickness="1"
            BorderBrush="#404B5966" Background="#FF0F1113" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Border x:Name="TitleSurface" Grid.Row="0" CornerRadius="0" Background="#FF151719"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="16,0,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="CT" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="CacheTrim" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text=" · оптимизатор системы" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Appearance="Transparent" Width="42" Height="34" Click="OnMinimizeClick"
                                   shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <ui:Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Appearance="Transparent" Width="42" Height="34" Click="OnMaximizeClick"
                                   shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <ui:Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Appearance="Transparent" Width="42" Height="34" Click="OnCloseClick"
                                   shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="NavigationSurface" Grid.Column="0" Background="#FF141619" BorderBrush="#26333E" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,12,10,10">
                        <StackPanel DockPanel.Dock="Top" Margin="8,2,8,14">
                            <TextBlock Text="CacheTrim" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="SYSTEM TOOLS · 2.1" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,0">
                            <TextBlock x:Name="AdminText" Text="АДМИНИСТРАТОР" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel x:Name="NavigationItems" />
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="PageHost" Margin="26,20,26,28" />
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Border x:Name="StatusSurface" Grid.Row="2" Padding="14,0" BorderThickness="0,1,0,0" BorderBrush="#26333E"
                    Background="#FF151719" CornerRadius="0">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="StatusAdmin" DockPanel.Dock="Left" Text="АДМИНИСТРАТОР" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="готово" FontSize="10" Margin="16,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
