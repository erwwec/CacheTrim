<Window x:Class="CacheTrim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CacheTrim" Width="1320" Height="860" MinWidth="1010" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="#FF0F1113" ShowInTaskbar="True"
        Loaded="OnWindowLoaded" StateChanged="OnWindowStateChanged" Closed="OnWindowClosed">
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#FFECEEF2" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="11" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#445F6F7D" /></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Close" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                        <Setter TargetName="Surface" Property="Background" Value="#FFC42B1C" />
                    </MultiTrigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="19" Height="19" CornerRadius="5" BorderThickness="1"
                                    BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" Background="Transparent">
                                <TextBlock x:Name="Mark" Text="✓" FontSize="13" FontWeight="Bold" Foreground="#101820"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowSurface" Margin="0" CornerRadius="0" BorderThickness="1"
            BorderBrush="#404B5966" Background="#FF0F1113" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Border x:Name="TitleSurface" Grid.Row="0" CornerRadius="0" Background="#FF151719"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="16,0,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="CT" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="CacheTrim" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text=" · оптимизатор системы" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Width="42" Height="38" ToolTip="Свернуть" Click="OnMinimizeClick"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Width="42" Height="38" ToolTip="Развернуть или восстановить" Click="OnMaximizeClick"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Width="42" Height="38" ToolTip="Закрыть" Tag="Close" Click="OnCloseClick"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="NavigationSurface" Grid.Column="0" Background="#FF141619" BorderBrush="#26333E" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,12,10,10">
                        <StackPanel DockPanel.Dock="Top" Margin="8,2,8,14">
                            <TextBlock Text="CacheTrim" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="BrandVersion" Text="SYSTEM TOOLS" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,0">
                            <TextBlock x:Name="AdminText" Text="АДМИНИСТРАТОР" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Button Content="Поиск функций · Ctrl+F" Margin="3,0,3,10" Padding="8,6" Click="OpenSearch_Click" />
                                <StackPanel x:Name="NavigationItems" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border x:Name="BusyBanner" Visibility="Collapsed" Margin="26,16,26,0" Padding="16,12"
                            CornerRadius="8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Выполняется операция" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="BusyOperationText" Margin="0,4,0,8" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="BusyProgressBar" Height="8" IsIndeterminate="True" Minimum="0" Maximum="100" Foreground="{DynamicResource SystemAccentColorBrush}" />
                            <TextBlock x:Name="BusyProgressDetail" Visibility="Collapsed" Margin="0,7,0,0" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Пожалуйста, подожди — время зависит от операции." Margin="0,7,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="PageHost" Margin="26,20,26,28" />
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Border x:Name="StatusSurface" Grid.Row="2" Padding="14,0" BorderThickness="0,1,0,0" BorderBrush="#26333E"
                    Background="#FF151719" CornerRadius="0">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="StatusAdmin" DockPanel.Dock="Left" Text="АДМИНИСТРАТОР" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="готово" FontSize="10" Margin="16,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
