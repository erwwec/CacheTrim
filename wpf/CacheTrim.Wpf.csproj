<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The shipped pet is pinned in the app; release CI overrides this with the hash of its own pet build. -->
    <TrustedDesktopPetSha256 Condition="'$(TrustedDesktopPetSha256)' == ''">68bd1de9760e55c1cd09f8bfc95569c473ff408725d0f454dde101b8f5218410</TrustedDesktopPetSha256>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>CacheTrim</RootNamespace>
    <AssemblyName>CacheTrim</AssemblyName>
    <Version>2.1.25</Version>
    <AssemblyVersion>2.1.25</AssemblyVersion>
    <FileVersion>2.1.25</FileVersion>
    <InformationalVersion>2.1.25</InformationalVersion>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TrustedDesktopPetSha256</_Parameter1>
      <_Parameter2>$(TrustedDesktopPetSha256)</_Parameter2>
    </AssemblyAttribute>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <Compile Include="..\winui\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\winui\TweakCatalog.cs" Link="Core\TweakCatalog.cs" />
    <EmbeddedResource Include="ThirdPartyNotices.md;WPF-UI-LICENSE.md;WPF-UI-THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\RELEASE_NOTES.md" LogicalName="CacheTrim.ReleaseNotes.txt" />
    <Resource Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="..\companion\AnimeAvatar\AnimeAvatar.exe.part00" LogicalName="CacheTrim.AnimeAvatar.part00" />
    <EmbeddedResource Include="..\companion\AnimeAvatar\AnimeAvatar.exe.part01" LogicalName="CacheTrim.AnimeAvatar.part01" />
    <EmbeddedResource Include="..\companion\AnimeAvatar\THIRD_PARTY_NOTICES.txt" LogicalName="CacheTrim.AnimeAvatar.Notices.txt" />
    <EmbeddedResource Include="..\companion\TweakerScripts\explorer.bat" LogicalName="CacheTrim.TweakerScripts.explorer.bat" />
    <EmbeddedResource Include="..\companion\TweakerScripts\win-tweaker.bat" LogicalName="CacheTrim.TweakerScripts.win-tweaker.bat" />
  </ItemGroup>
</Project>

